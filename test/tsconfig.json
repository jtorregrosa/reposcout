{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["../web/src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [".", "../web/src/**/*.test.ts", "../web/src/**/*.test.tsx", "../web/src/test/setup.ts", "../web/src/test/render.tsx"]
}
